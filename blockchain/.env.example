# Admin and platform roles
ADMIN_ADDRESS=0x000000000000000000000000000000000000dEaD
PLATFORM_ADDRESS=0x000000000000000000000000000000000000BEEF

# Comma-separated list of issuer addresses (optional)
ISSUER_ADDRESSES=

# Subscription prices in wei (denominated in Base Sepolia ETH)
SUBSCRIPTION_PRICE_WEI_BASE=1000000000000000
SUBSCRIPTION_PRICE_WEI_PLUS=2000000000000000

# Deployer private key
PRIVATE_KEY=0x1234567890123456789012345678901234567890123456789012345678901234

# Base Sepolia RPC endpoint
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key for contract verification (optional)
BASESCAN_API_KEY=
