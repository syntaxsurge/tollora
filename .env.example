NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# EIP-712 payment token metadata used for x402 signatures.
NEXT_PUBLIC_PAYMENT_TOKEN_NAME=MUSD
NEXT_PUBLIC_PAYMENT_TOKEN_SYMBOL=MUSD
NEXT_PUBLIC_PAYMENT_TOKEN_LABEL=MUSD
NEXT_PUBLIC_PAYMENT_TOKEN_VERSION=2
NEXT_PUBLIC_PAYMENT_TOKEN_DECIMALS=18
# Use eip3009 for tokens that support transferWithAuthorization; use permit2 for standard ERC-20 approve + Permit2 flows.
NEXT_PUBLIC_PAYMENT_TOKEN_TRANSFER_METHOD=permit2
# Mezo-compatible x402 facilitator for MUSD settlement.
X402_FACILITATOR_URL=https://facilitator.vativ.io/
# Optional local facilitator signer. When set, Tollora settles x402 payments
# in-process with EIP-7623 floor-safe gas instead of relying on the HTTP
# facilitator's gas estimate. Fund this wallet with native gas.
X402_FACILITATOR_PRIVATE_KEY=

